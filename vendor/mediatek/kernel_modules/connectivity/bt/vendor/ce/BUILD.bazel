load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "headers",
    srcs = glob([
        "*.h",
    ]),
)

define_mgk_ko(
    name = "btmtk_vendor_ce",
    srcs = glob([
        "*.c",
        "*.h",
        "Kbuild",
        "Makefile",
    ]) + [
		"//vendor/mediatek/kernel_modules/connectivity/bt/linux_v2:headers",
    ],
    deps = [
		"//vendor/mediatek/kernel_modules/connectivity/bt/linux_v2:btmtk_unify",
    ],
    outs = [
		"btmtk_vnd_ce.ko",
    ],
)

