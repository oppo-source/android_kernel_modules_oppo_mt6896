load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "headers",
    srcs = glob([
        "*.h",
    ]),
)

define_mgk_ko(
    name = "btmtk_vendor",
    srcs = glob([
        "*.c",
        "*.h",
        "Kbuild",
        "Makefile",
    ]) + [
        "//vendor/mediatek/kernel_modules/connectivity/bt/mt66xx:headers",
    ],
    deps = [
        "//vendor/mediatek/kernel_modules/connectivity/bt/mt66xx:btif",
    ],
    outs = [
        "btmtk_vnd.ko",
    ],
)
