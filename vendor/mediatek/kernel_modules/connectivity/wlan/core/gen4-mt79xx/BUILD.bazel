        "os/linux/hif/sdio/include",
        "prealloc/include",
        "reset/include",
    ],
    hdrs = glob([
        "**/*.h"
    ]),
    local_defines = [
        "LINUX",
    ],
    copts = copts_def1 + [
        "-include", "$(location :parse_makefile)",
    ],
    out = "mtprealloc_mt7902.ko",
)

