define_mgk_ddk_ko(
    name = "wlan_mt7902",
    module_type = "main",
    ko_deps = [
        ":mtreset_sdio_ko",
        ":mtprealloc_sdio_ko",
        ":wlan_mt7902_sdio_ko",
    ],
)

define_mgk_ddk_ko(
    name = "mtreset_sdio_ko",
    module_type = "sub",
    srcs = [":resetko_sources",
            ":parse_makefile"],
    includes = [
        "reset/include",
    ],
    hdrs = glob([
        "**/*.h"
    ]),
    local_defines = [
        "LINUX",
    ],
    copts = copts_def1 + [
        "-include", "$(location :parse_makefile)",
    ],
    out = "mtreset.ko",
)

define_mgk_ddk_ko(
    name = "mtprealloc_sdio_ko",
    module_type = "sub",
    srcs = [
        ":parse_makefile",
        "prealloc/prealloc.c",
