$(info $$MTK_COMBO_CHIP is [MT7961])

ccflags-y:=$(filter-out -UMT7961,$(ccflags-y))
ccflags-y += -DMT7961
CONFIG_SDIO_INTR_ENHANCE_FORMAT=2
CONFIG_SUPPORT_SCHED_SCAN=y
CONFIG_SUPPORT_MDNS_OFFLOAD=y
CONFIG_SUPPORT_DUAL_WTBL_GTK_REKEY_OFFLOAD=y
# MT7961's max cmd tx resource = 3
# so QM_CMD_RESERVED_THRESHOL must be less than 3
CONFIG_QM_CMD_RESERVED_THRESHOLD=1
ifeq ($(CONFIG_MTK_COMBO_WIFI_HIF), pcie)
CONFIG_SUPPORT_WFDMA_REALLOC=n
else
CONFIG_SUPPORT_WFDMA_REALLOC=y
endif
CONFIG_MTK_WIFI_CONNAC2X=y
CONFIG_MTK_WIFI_11AX_SUPPORT=y
# unless patch wifi 6G setting in kernel before kernel version 5.4,
# it will build fail when enable wifi 6G flag
ifeq ($(call kver_ge,5,4,0),1)
CONFIG_MTK_WIFI_6G_SUPPORT=y
else
CONFIG_MTK_WIFI_6G_SUPPORT=n
endif
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WIFI_TWT_HOTSPOT_SUPPORT=y
CONFIG_MTK_WIFI_TWT_HOTSPOT_AC_SUPPORT=n
CONFIG_MTK_WIFI_CSI=y
CONFIG_WIFI_TWT_STAPS_DISABLE_SCAN=n
CONIFG_WIFI_TWT_WIFI_6E_CERTIFICATION=n
CONFIG_SUPPORT_WIFI_DL_BT_PATCH=y
CONFIG_SUPPORT_PCIE_ASPM=y
CONFIG_SUPPORT_PCIE_ASPM_IMPROVE=n
CONFIG_SUPPORT_CMD_OVER_WFDMA=y
CFG_SUPPORT_HOST_RX_WM_EVENT_FROM_PSE=y
CONFIG_MTK_WIFI_SW_FAST_PATH=n
CONFIG_MTK_DBDC_SW_FOR_P2P_LISTEN=n
CFG_SUPPORT_SW_BIP_GMAC=y
CONFIG_SUPPORT_SAP_WPA3_H2E=y
CONFIG_MTK_PASSPOINT_R2_SUPPORT=y
CONFIG_SUPPORT_SAP_OWE=y
CONFIG_WIFI_RAM_COEX_SPDT_SHR_ANT_CTRL=y
CONFIG_SUPPORT_IPC_WITHOUT_MMIO_READ=y
CONFIG_SUPPORT_DISABLE_DATA_DDONE_INTR=y
CONFIG_SUPPORT_FW_IDX_LOG_TRANS=y
CONFIG_SUPPORT_UPDATE_HE_BSS_COLOR_FROM_BEACON=y
CONFIG_SUPPORT_APF=y
CONFIG_USB_RECYCLE_REQ_IN_IRQ=y
CONFIG_MTK_WIFI_NAN=y
CONFIG_MTK_WIFI_NAN_SUPPORT_R4=n
CONFIG_WIFI_TESTMODE_FW_REDOWNLOAD=y
CONFIG_SUPPORT_DRV_OWN_MODE_CONTROL=y
CONFIG_SUPPORT_FW_IDX_LOG_SAVE=y
CONFIG_MTK_SUPPLICANT_ROAMING_ENHANCE=y
CONFIG_SUPPORT_SAP_TX_FAIRNESS=y
CONFIG_SUPPORT_RTT=n
CONFIG_SUPPORT_RTT_RSTA=n

# Only 11b Test
CONFIG_SUPPORT_11B_DYNAMIC=y

ifeq ($(CONFIG_MTK_COMBO_WIFI_HIF), sdio)
CONFIG_TX_RSRC_WMM_ENHANCE=y
CONFIG_SUPPORT_MAILBOX_ACK=y
endif
ifeq ($(CONFIG_MTK_COMBO_WIFI_HIF), pcie)
CFG_COALESCING_INTERRUPT=y
CONFIG_SUPPORT_PCIE_WFDMA_WMM_SCH=y
CONFIG_RX_WORK_SUPPORT=y
endif
# For Buzzard, only PCIE & USB support
ifneq ($(CONFIG_MTK_COMBO_WIFI_HIF), sdio)
CONFIG_SUPPORT_DEBUG_SOP=y
endif
CONFIG_SUPPORT_WOW_EINT=y
CONFIG_SUPPORT_SUPPLICANT_SME=y
CONFIG_SUPPORT_OWE=y
CONFIG_REDIRECT_OID_SUPPORT=y
CONFIG_SUPPORT_CFG80211_QUEUE=y
CONFIG_RX_REPORT_FORMAT=1
CONFIG_SUPPORT_HE_ER=n
CONFIG_WIFI_FWDL_UMAC_RESERVE_SIZE_PARA=128
CONFIG_WIFI_TX_ETH_CHK_EMPTY_PAYLOAD=y
# Default disable feature notify country code to bt
CONFIG_SUPPORT_BT_SKU=n
# For WAC module API
# y: enable, n: disable
CONFIG_SUPPORT_WAC=n
