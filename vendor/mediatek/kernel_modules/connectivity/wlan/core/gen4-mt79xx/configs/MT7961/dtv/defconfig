CONFIG_NUM_DIFFERENT_CHANNELS_STA=1
CONFIG_NUM_DIFFERENT_CHANNELS_P2P=1
CONFIG_DRIVER_INITIAL_RUNNING_MODE=3
CONFIG_ENABLE_WAKE_LOCK=n
CONFIG_DEFAULT_DBG_LEVEL=0xF
CONFIG_TX_DIRECT=y
CONFIG_RX_DIRECT=y
CONFIG_USB_REQ_TX_DATA_FFA_CNT=6
CONFIG_USB_REQ_TX_DATA_CNT=2
CONFIG_USB_REQ_RX_DATA_CNT=4
CONFIG_ENABLE_EFUSE_MAC_ADDR=y
CONFIG_P2P_SCAN_REPORT_ALL_BSS=0
CONFIG_SDIO_RX_AGG_WORKQUE=n

CONFIG_SUPPORT_SINGLE_SKU_LOCAL_DB=n

CONFIG_SUPPORT_TSF_SYNC=y
CONFIG_CHIP_RESET_USB_DISCONNECT=y
CONFIG_POWER_OFF_CTRL_SUPPORT=y
CONFIG_DC_USB_WOW_CALLBACK=y
CONFIG_WIFI_CFG_FN='"wifi_mt7961.cfg"'

CONFIG_SUPPORT_P2P_CSA=y
CONFIG_SUPPORT_DPP=y

# Extend stack limit size to avoid build error
ifeq ($(CONFIG_KASAN), y)
ccflags-y += -Wframe-larger-than=4096
else
ccflags-y += -Wframe-larger-than=1400
endif
ccflags-y += $(call cc-disable-warning, unused-but-set-variable)
PLATFORM_FLAGS += $(call cc-disable-warning, unused-but-set-variable)
