$(warning MTK_ANDROID_VERSION=$(MTK_ANDROID_VERSION))
# now for android V, MTK_ANDROID_VERSION is not define
ifndef MTK_ANDROID_VERSION
MTK_ANDROID_VERSION = v-base
endif

ifneq ($(filter t-% u-% v-% 16-%, $(MTK_ANDROID_VERSION)),)
ccflags-y += -DCFG_SUPPORT_RESET_TRIGGERED_VENDOR_EVENT=1
endif

CONFIG_SUPPORT_DFS_OFFLOAD=y
CONFIG_SUPPORT_RX_NAPI=y
CONFIG_DRIVER_INF_NAME_CHANGE=n
CONFIG_SCAN_RADIOINFO=y
#0: no mem shrink 1: low mem shrink 2: middle mem shrink 3: high mem shrink
CONFIG_MEM_SHRINK_LEVEL=0

CONFIG_CHIP_RESET_USE_DTS_GPIO_NUM=y
CONFIG_CHIP_RESET_USE_LINUX_GPIO_API=y
CONFIG_CHIP_RESET_DTS_COMPATIBLE_NAME='"mediatek,mtk-wifi-reset"'
CONFIG_CHIP_RESET_GPIO_PROPERTY_NAME='"reset-gpio-num"'
CONFIG_CHIP_RESET_INVERT_PROPERTY_NAME='"invert-ms"'
CONFIG_CHIP_RESET_DEFAULT_VAL_PROPERTY_NAME='"default-gpio-val"'

CONFIG_SUPPORT_MTK_SCAN_EVENT=y
CONFIG_SUPPORT_P2P_CSA=y
CONFIG_DBG_PRINT_RTP_INFO=y
CONFIG_SUPPORT_MDNS_OFFLOAD=y
ifeq ($(filter 16-%, $(MTK_ANDROID_VERSION)),)
CONFIG_TEST_CODE_FOR_MDNS=y
endif
