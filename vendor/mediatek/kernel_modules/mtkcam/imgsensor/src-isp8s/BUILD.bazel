# else /*OPLUS_FEATURE_CAMERA_COMMON*/
# driver list to included
config_cust_kernel_imgsensor = "cjmain_mipi_raw cjtele_mipi_raw cjfront_mipi_raw hhmwcs_mipi_raw hhmain_mipi_raw hhuwide_mipi_raw hhtele_mipi_raw hhfront_mipi_raw cjtele2_mipi_raw"

config_subdrvs = config_cust_kernel_imgsensor.split(" ")

# common
common_subdrvs = glob([
    "common/**/Makefile",
])
common_subdrvs_split = [
    subdrv.split("/")[-2] for subdrv in common_subdrvs
]
intersect_comm_drvs = [item for item in common_subdrvs_split if item in config_subdrvs]  # get intersection

# oplus
oplus_subdrvs = glob([
    "oplus/common/**/Makefile",
])
oplus_subdrvs_split = [
    subdrv.split("/")[-2] for subdrv in oplus_subdrvs
]
intersect_oplus_drvs = [item for item in oplus_subdrvs_split if item in config_subdrvs]  # get intersection

subdrvs_c = [
    "common/{}/*.c".format(p) if glob(["common/{}/**".format(p)]) else "" for p in intersect_comm_drvs
] + [
    "oplus/common/{}/*.c".format(p) if glob(["oplus/common/{}/**".format(p)]) else "" for p in intersect_oplus_drvs
]
subdrvs_def_split = [
    "E({})".format(subdrv) for subdrv in intersect_comm_drvs
] + [
    "E({})".format(subdrv) for subdrv in intersect_oplus_drvs
]
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/

subdrvs_def_str = ",".join(subdrvs_def_split)

#custom
cust_include_c_files = [
    "common/imx598_mipi_raw/legacy/imx598mipiraw_Sensor.c",
    "common/imx758_mipi_raw/legacy/imx758mipiraw_Sensor.c",
    "common/imx989_mipi_raw/legacy/imx989mipiraw_Sensor.c",
    "common/ov64b_mipi_raw/legacy/ov64bmipiraw_Sensor.c",
]
cust_exclude_c_files = [
]
cust_cflag_defs = [
    "IMX598_ISF_DBG=1",
    "IMX758_ISF_DBG=1",
    "IMX989_ISF_DBG=1",
    "OV64B_ISF_DBG=1",
]

print("imgsensor_isp8s drvs c = {}".format(subdrvs_c))
print("imgsensor_isp8s drvs def = {}".format(subdrvs_def_str))

define_mgk_ddk_ko(
    name = "imgsensor_isp8s",
    srcs = glob([
        "*.c",
        "common/*.c",
# ifdef OPLUS_FEATURE_CAMERA_COMMON
        "oplus/common/*.c",
        "oplus/oplus-adaptor-subdrv-ctrl.c",
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/
        "virt-sensor/*.c",
        "frame-sync/*.c",
        "frame-sync/custom/*.c",
    ]) + glob(cust_include_c_files) + glob(subdrvs_c, exclude = cust_exclude_c_files),  # Build all subdrivers contains Makefile
    ko_deps = [
        "//vendor/mediatek/kernel_modules/mtkcam/imgsensor/src-isp8s/imgsensor-glue:imgsensor-glue_isp8s",
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal/src_v4l2:mtk_cam_cal",
        "//kernel_device_modules-{}/drivers/misc/mediatek/aee/aed:aee_aed".format(kernel_version),
        "//kernel_device_modules-{}/drivers/i3c/master:mtk-i3c-master-mt69xx".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/i3c_i2c_wrap:mtk-i3c-i2c-wrap".format(kernel_version),
# ifdef OPLUS_FEATURE_CAMERA_COMMON
        "//vendor/oplus/kernel/camera/imgsensor/dfx:oplus_cam_event_report",
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/
    ],
    header_deps = [
        "//vendor/mediatek/kernel_modules/mtkcam:mtkcam_header",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsensor:imgsensor_header",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsensor/src-isp8s:imgsensor_isp8s_header",
        "//kernel_device_modules-{}/drivers/i3c/master:i3c_master_api_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/i3c_i2c_wrap:i3c_i2c_wrap_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/imgsensor:imgsensor_kd_header".format(kernel_version),
# ifdef OPLUS_FEATURE_CAMERA_COMMON
        "//vendor/oplus/kernel/camera:oplus_camera_header",
        "//vendor/oplus/kernel/camera/imgsensor/dfx:oplus_cam_event_report_header",
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/
    ],
    hdrs = glob([
        "**/*.h"
    ]),
    copts = [
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/mt-plat",
        "-I$(srctree)/drivers/thermal",
    ],
    includes = [
        ".",
        "frame-sync",
        "virt-sensor",
        "imgsensor-glue",
# ifdef OPLUS_FEATURE_CAMERA_COMMON
        "oplus",
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/
    ],
    local_defines = [
        "IMGSENSOR_SUBDRVS={}".format(subdrvs_def_str),
# ifdef OPLUS_FEATURE_CAMERA_COMMON
        "OPLUS_FEATURE_CAMERA_COMMON",
        "CONFIG_OPLUS_CAM_EVENT_REPORT_MODULE",
        "IS_ISP8S",
# endif /*OPLUS_FEATURE_CAMERA_COMMON*/
    ] + cust_cflag_defs,
)

## ddk headers

ddk_headers(
    name = "imgsensor_isp8s_header",
    hdrs = glob([
        "**/*.h"
    ]),
    includes = ["."],
    visibility = ["//visibility:public"],
)

