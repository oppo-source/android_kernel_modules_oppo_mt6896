package(
    default_visibility = [
        "//visibility:public",
    ],
)

ddk_prebuilt_object(
	name = "eas_ext_grp_cfi_int",
	src = "src/eas_ext_grp_cfi_int.o",
	config = "CONFIG_MTK_GAS_CFI_N_INI",
	config_bool_value = True,
	visibility = ["//visibility:private"],
)

ddk_prebuilt_object(
	name = "eas_ext_grp_cfi",
