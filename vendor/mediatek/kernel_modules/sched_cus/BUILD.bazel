	config = "CONFIG_MTK_GAS_NO_CFI",
	config_bool_value = True,
	visibility = ["//visibility:private"],
)

define_mgk_ddk_ko(
    name = "eas_ext_cus",

    srcs = ["src/eas_ext_main.c"],
    hdrs = glob([
        "**/*.h",
        ]),

    ko_deps = ["//kernel_device_modules-{}/drivers/misc/mediatek/sched:scheduler".format(kernel_version)],

    includes = [".", "src"],
    prebuilt_srcs = [
        ":eas_ext_grp_cfi_int",
        ":eas_ext_grp_cfi",
        ":eas_ext_grp_no_cfi",
    ],

    copts = [
        "-I$(srctree)/kernel/",
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/sched/",
    ],
    kconfig = "sched_int.Kconfig",
    out = "eas_ext.ko",
)

