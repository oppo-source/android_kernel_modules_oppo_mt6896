load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "oplus_cam_event_report",
    srcs = [
        "oplus_cam_event_rpt.c",
        "oplus_cam_olc_exception.c",
    ],
    includes = [
        ".",
    ],
    hdrs = [
        "oplus_cam_event_rpt.h",
    ],
    ko_deps = [
        "//vendor/oplus/kernel/dft/bazel:oplus_bsp_dft_olc",
        "//vendor/oplus/kernel/dft/bazel:oplus_bsp_dft_kernel_fb",
    ],
    header_deps = [
        "//vendor/oplus/kernel/camera:oplus_camera_header",
    ],
    local_defines = [
        "CONFIG_OPLUS_FEATURE_OLC=1",
        "CONFIG_OPLUS_FEATURE_FEEDBACK",
    ],
)

ddk_headers(
    name = "oplus_cam_event_report_header",
    hdrs = [
    ] + glob([
        "**/*.h"
    ]),
    includes = ["."],
    visibility = ["//visibility:public"],
)