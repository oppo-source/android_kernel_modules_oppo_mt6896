		oplus,switch_ctrl-gpio = <&pio 215 0x00>;
		oplus,dpdm_switch1-gpio = <&pio 214 0x00>;
		pinctrl-names = "switch_ctrl_ap", "switch_ctrl_vooc", "switch_ctrl_ufcs",
				"dpdm_switch_ap", "dpdm_switch_vooc", "dpdm_switch_ufcs";
