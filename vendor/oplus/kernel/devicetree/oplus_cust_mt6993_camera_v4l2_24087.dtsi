};

&i2c10 {
	clock-frequency = <1000000>;
	#address-cells = <1>;
	#size-cells = <0>;
	camera_tof_main:tmf8806@41 {
		compatible = "ams,tmf8806";
		pinctrl-names = "default";
		pinctrl-0 = <&camera_pins_tof_i2c_mode>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x41>;
		enable-gpio = <&pio 22 0x0>;
		poll_period = <0xA>;    /* poll period (100 usec) */
		port {
			main_tof: endpoint {
				remote-endpoint = <&main_tof_endpoint>;
			};
		};
	};
};

&thermal_zones {
	camera0: camera0 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor0>;
		trips {
			camera0_crit: camera0-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera1: camera1 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor1>;
		trips {
			camera1_crit: camera1-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera2: camera2 {
